# Shell (host) micro-frontend configuration.
# Copy to `.env` for local dev, or set these as environment variables on your
# deploy platform. No trailing slashes on URLs.

# Public origin where the shell is served. Used as Vite `base`.
VITE_PUBLIC_URL=https://shell.example.com
# Port the dev/preview server binds to (ignored by most static hosts).
VITE_PORT=3000
# Public origins of the deployed remotes — each must serve /remoteEntry.js with CORS.
VITE_CATALOG_URL=https://catalog.example.com
VITE_CART_URL=https://cart.example.com
